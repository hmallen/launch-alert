# Prefer `python3 -m launch_alert init` to generate a random topic automatically.
# Copying this file requires setting NTFY_TOPIC to a long random name yourself.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
LEAD_MINUTES=30
POLL_SECONDS=300
DISPLAY_TIMEZONE=America/Chicago
DB_PATH=data/launch-alert.sqlite3
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0
LL2_TOKEN=
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
MAX_DATA_AGE_SECONDS=900
